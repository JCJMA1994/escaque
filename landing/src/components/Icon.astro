---
/** Iconos propios de Escaque (mismos SVG que la app). Toman el color del texto. */
interface Props {
  name: string;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;
const all = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const raw = all[`../icons/${name}.svg`];
if (!raw) throw new Error(`Icono desconocido: ${name}`);
const svg = raw.replace(
  '<svg ',
  `<svg width="${size}" height="${size}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} focusable="false" `,
);
---
<span class:list={['icon', className]} set:html={svg} />
